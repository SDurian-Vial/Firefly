---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import SolarTerm from "@/components/widget/SolarTerm.svelte";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";
import { getSolarTermInfo } from "@/utils/solar-term-utils";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const initial = getSolarTermInfo(new Date());
---

<WidgetLayout
	name={i18n(I18nKey.solarTerm)}
	showTitle={showTitle}
	id="solar-term"
	class={className}
	style={style}
>
	<SolarTerm client:load initial={initial} />
</WidgetLayout>
